{
  "manifest_version": 3,
  "name": "Zalo Web Audio Player - Trình phát âm thanh trực tuyến",
  "version": "1.0.0",
  "description": "Phát trực tiếp file ghi âm và âm thanh (.m4a, .mp3, .wav, .aac, .ogg...) trên Zalo Web thay vì phải tải về máy.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.zalo.me/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Cài đặt Zalo Audio Player"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.zalo.me/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js",
        "content/styles.css",
        "icons/*"
      ],
      "matches": [
        "https://chat.zalo.me/*"
      ]
    }
  ]
}
